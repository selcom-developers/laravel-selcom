{
    "name": "selcom-developers/laravel-selcom",
    "description": "Laravel integration for the Selcom API gateway: config, container bindings, webhooks, optional models, commands and testing helpers, built on selcom-developers/selcom-php. Not affiliated with Selcom Paytech Ltd.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["selcom", "laravel", "tanzania", "payments", "mobile-money", "webhooks"],
    "homepage": "https://github.com/selcom-developers/laravel-selcom",
    "support": {
        "issues": "https://github.com/selcom-developers/laravel-selcom/issues",
        "source": "https://github.com/selcom-developers/laravel-selcom"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/selcom-developers/selcom-php" }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "laravel/framework": "^12.0 || ^13.0",
        "psr/clock": "^1.0",
        "selcom-developers/selcom-php": "^0.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "SelcomDevelopers\\LaravelSelcom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SelcomDevelopers\\LaravelSelcom\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SelcomDevelopers\\LaravelSelcom\\SelcomServiceProvider"
            ],
            "aliases": {
                "Selcom": "SelcomDevelopers\\LaravelSelcom\\Facades\\Selcom"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@composer validate",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": false,
        "classmap-authoritative": false,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
